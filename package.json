{
  "name": "dsh-music-player",
  "version": "0.1.62",
  "private": true,
  "license": "MIT",
  "author": "uki-2 <uki-2@users.noreply.github.com> (https://github.com/uki-2)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uki-2/dsh-music-player.git"
  },
  "homepage": "https://github.com/uki-2/dsh-music-player#readme",
  "bugs": {
    "url": "https://github.com/uki-2/dsh-music-player/issues"
  },
  "description": "Floating glass vinyl music player in the DSH Web UI with a Bilibili engine: read favorite-folder playlists, search, stream audio, drag and expand.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bili": "./bili.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bili.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
