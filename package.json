{
  "name": "dsh-music-player-bili",
  "version": "0.1.103",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "uki-2 <uki-2@users.noreply.github.com> (https://github.com/uki-2)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uki-2/dsh-music-player-bili.git"
  },
  "homepage": "https://github.com/uki-2/dsh-music-player-bili#readme",
  "bugs": {
    "url": "https://github.com/uki-2/dsh-music-player-bili/issues"
  },
  "description": "A frosted-glass vinyl player floating over DSH (DeepSeek Harness): play public Bilibili playlists, search and play instantly, no login. 在 DSH 里挂一台黑胶唱机，贴 B 站公开歌单链接就能听。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "music-player",
    "audio",
    "vinyl"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bili": "./bili.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bili.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs/THIRD_PARTY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
